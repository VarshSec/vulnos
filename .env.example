# ============================================================================
# VulnOS environment template
# Copy to .env and fill in locally. NEVER commit .env.
# All values below are placeholders, not working credentials.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME=VulnOS
APP_ENV=development
APP_DEBUG=false
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-48-byte-value
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
API_KEY_PEPPER=replace-with-a-random-pepper
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://vulnos:change-me@localhost:5432/vulnos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=vulnos.default
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3600
CELERY_TASK_TIME_LIMIT_SECONDS=3900

# --- Evidence object storage (S3-compatible) ---------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_EVIDENCE=vulnos-evidence
S3_BUCKET_REPORTS=vulnos-reports
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=SSE-S3
S3_SIGNED_URL_TTL_SECONDS=300
EVIDENCE_MAX_BODY_BYTES=5242880
EVIDENCE_RETENTION_DAYS=90

# --- Secrets backend ---------------------------------------------------------
# file | vault | aws_secrets_manager | gcp_secret_manager
SECRET_BACKEND=file
SECRET_FILE_PATH=./.secrets/dev-secrets.json
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=
AWS_KMS_KEY_ID=
GCP_PROJECT_ID=

# --- Scope enforcement -------------------------------------------------------
SCOPE_ENFORCEMENT_MODE=enforce
SCOPE_DEFAULT_DENY=true
SCOPE_MAX_REDIRECTS=5
SCOPE_RESOLVER_PRIMARY=1.1.1.1
SCOPE_RESOLVER_SECONDARY=8.8.8.8
SCOPE_ALLOW_PRIVATE_RANGES=false
SCOPE_BLOCK_CLOUD_METADATA=true
EGRESS_PROXY_URL=http://egress-proxy:8080
EGRESS_PROXY_REQUIRED=true

# --- Worker / sandbox --------------------------------------------------------
WORKER_IMAGE=vulnos/worker:dev
WORKER_CPU_LIMIT=2
WORKER_MEMORY_LIMIT_MB=2048
WORKER_PIDS_LIMIT=256
WORKER_TIMEOUT_SECONDS=1800
WORKER_TMPFS_MB=512

# --- Budgets -----------------------------------------------------------------
DEFAULT_SCAN_MAX_WALL_CLOCK_MINUTES=120
DEFAULT_SCAN_MAX_REQUESTS=50000
DEFAULT_SCAN_MAX_COST_USD=25
DEFAULT_SCAN_MAX_AI_TOKENS=2000000
MAX_CONCURRENT_SCANS_PER_PROJECT=2

# --- AI router (provider-independent) ---------------------------------------
AI_ROUTER_ENABLED=true
AI_DEFAULT_TASK_TIER=medium
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=120
AI_CACHE_TTL_SECONDS=86400

# OpenAI-compatible
AI_OPENAI_COMPAT_BASE_URL=
AI_OPENAI_COMPAT_API_KEY=

# Provider-specific (all optional; keys live in the secret backend in prod)
AI_ANTHROPIC_API_KEY=
AI_GOOGLE_API_KEY=
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_API_KEY=not-needed

# --- Reporting ---------------------------------------------------------------
REPORT_SIGNING_KEY_ID=
REPORT_PDF_RENDERER=playwright

# --- Feature flags (initial scope only) -------------------------------------
FEATURE_AUTONOMOUS_AGENTS=false
FEATURE_STATIC_ANALYSIS=false
FEATURE_PDF_REPORTS=false
